{
  "backbone": {
    "vocab_size": 261,
    "hidden_size": 64,
    "intermediate_size": 128,
    "num_hidden_layers": 2,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "max_position_embeddings": 512,
    "pointer_dim": 32
  },
  "training": {
    "steps": 160,
    "accumulation": 2,
    "learning_rate": 0.003,
    "save_every": 40,
    "seed": 42,
    "choice_permutation": true
  },
  "objective": {
    "ce": 1.0,
    "reinforce": 0.0,
    "ordinal": 0.1
  },
  "limits": {
    "branch": 512,
    "aggregate": 8192,
    "max_questions": 64
  },
  "execution": {
    "version": "parallel-questions-v1",
    "max_branches": 16,
    "max_padded_tokens": 65536,
    "max_cache_bytes": 536870912,
    "sort_by_length": true
  }
}
