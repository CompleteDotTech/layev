{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$"
              },
              "transport": {
                "const": "local"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "transport",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$"
              },
              "transport": {
                "const": "wandb"
              },
              "entity": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$"
              },
              "project": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              }
            },
            "required": [
              "id",
              "transport",
              "entity",
              "project",
              "limit"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$"
              },
              "transport": {
                "const": "s3"
              },
              "bucket": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "transport",
              "bucket",
              "key"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
